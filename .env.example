# PostgreSQL – use DATABASE_URL OR the individual fields (DATABASE_URL takes priority).
DATABASE_URL=
DB_USER=padraic
DB_PASS=yourpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rpdata
DB_SSLMODE=disable

# JWT signing secret – required; use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Server
DEBUG=false
PORT=:9000

# TLS autocert domains (comma-separated, production only).
TLS_DOMAINS=mmrace.app,www.mmrace.app

# PostgreSQL source database – only needed when running cmd/migrate.
# SOURCE_DATABASE_URL takes priority over the individual SOURCE_DB_* values.
SOURCE_DATABASE_URL=
SOURCE_DB_USER=padraic
SOURCE_DB_PASS=source-password
SOURCE_DB_HOST=source-host
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=rpdata
SOURCE_DB_SSLMODE=disable
